# Copy this file to .env and fill in your values. .env is gitignored.

# OpenAlex polite-pool email. Required for stable rate limits.
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=you@example.org

# Optional: OpenAlex API key for the premium pool. Leave blank if using the free pool.
OPENALEX_API_KEY=

# Model API keys (needed for agent runs, not for corpus construction).
FIREWORKS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web-search provider for Arms D (web_only) and E (mcp_plus_web).
# Parallel AI: https://parallel.ai — Search API for AI agents.
PARALLEL_API_KEY=
